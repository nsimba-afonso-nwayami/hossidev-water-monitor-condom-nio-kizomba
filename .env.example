# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Email / SMTP Configuration Default (E-mail Corporativo Hossidev)
DEFAULT_EMAIL_PROVIDER="corporate_hossidev"

# Conta Corporativa Hossidev (SMTP com TLS implícito na porta 465)
SMTP_HOST="mail.hossidev.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="water.report@hossidev.com"
SMTP_PASSWORD="[CONFIGURAR_SENHA_CORPORATIVA_SERVIDOR]"
MAIL_FROM_NAME="water.report.@hossidev.com"
MAIL_FROM_ADDRESS="water.report@hossidev.com"

# Integração Gmail (Provedor alternativo preservado)
GMAIL_SMTP_HOST="smtp.gmail.com"
GMAIL_SMTP_PORT="587"
GMAIL_SMTP_SECURE="false"
GMAIL_SMTP_USER="etakizomba@gmail.com"
GMAIL_SMTP_PASSWORD="[CONFIGURAR_APP_PASSWORD_GOOGLE]"
GMAIL_MAIL_FROM_NAME="Hossidev Water Monitor"
GMAIL_MAIL_FROM_ADDRESS="etakizomba@gmail.com"

# Chave secreta de criptografia para credenciais SMTP salvas no banco (AES-256-GCM)
SMTP_ENCRYPTION_KEY="hossidev-scada-encryption-key-secure-seed-32"

# Chaves VAPID para Web Push Notifications do Sistema Operacional
VAPID_PUBLIC_KEY="[VAPID_PUBLIC_KEY]"
VAPID_PRIVATE_KEY="[VAPID_PRIVATE_KEY]"
VAPID_SUBJECT="mailto:water.report@hossidev.com"


